{
  "name": "bookmarket-monorepo",
  "version": "1.0.0",
  "description": "The BookMarket - Peer-to-Peer Second-Hand Book Marketplace",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "server": "npm run dev --prefix server",
